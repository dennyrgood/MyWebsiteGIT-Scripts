build/
dist/
dms_util/*.swp
*.un~
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
.aider*
# Claude Code machine-local settings (shared config goes in .claude/settings.json)
.claude/settings.local.json

# Timestamped script backups (e.g. nightly_summary.sh.bak.2026-08-25).
# sync-this stages with `git add -A`, so without this rule every ad-hoc backup
# gets committed. Git history is the real backup — all five that had accumulated
# by 2026-08-25 were byte-identical to commits already in the log.
*.bak
*.bak.*
