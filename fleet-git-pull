#!/usr/bin/env bash
# Fleet-wide git pull: for each fleet host, fast-forward-pulls every repo
# under its repo root (or just the ones named by --repos) when behind their
# upstream. Skips any repo with uncommitted changes (dirty) rather than risk
# a conflict, and skips any repo that isn't a clean fast-forward.
#
# Usage: ./fleet-git-pull.sh [--dry-run] [--repos repo1,repo2] [host ...]
#   --dry-run          report what would be pulled, don't actually pull
#   --repos r1,r2      comma-separated repo names to consider (default: all repos found, like fleet-git-check)
#   host ...           restrict to specific tailscale names (default: whole fleet)

set -uo pipefail

FLEET_HOSTS=(
  "imagebeast:win"
  "chatworkhorse:win"
  "travelbeast:win"
  "amsterdamdesktop:win"
  "denniss-macbook-air:mac"
  "denniss-2nd-macbook-air:mac"
  "surface3-gc:win"
  "surfacegolaptopgc:win"
  "mathes-mac-mini:mac"
  "remotews:win"
  "workbenchunix:ubuntu"
  "chatworkhorseunix:ubuntu"
  "fleetnas:ubuntu"
)

host_os() {
  local h="$1" pair name os
  for pair in "${FLEET_HOSTS[@]}"; do
    name="${pair%%:*}"
    os="${pair##*:}"
    if [ "$name" = "$h" ]; then
      echo "$os"
      return 0
    fi
  done
  return 1
}

DRY_RUN=0
REPOS=""
HOSTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --repos) shift; REPOS="$1" ;;
    *) HOSTS+=("$1") ;;
  esac
  shift
done

if [ "${#HOSTS[@]}" -eq 0 ]; then
  for pair in "${FLEET_HOSTS[@]}"; do HOSTS+=("${pair%%:*}"); done
fi
IFS=$'\n' HOSTS=($(sort <<<"${HOSTS[*]}")); unset IFS

SELF_NAME=""
if command -v tailscale >/dev/null 2>&1; then
  SELF_NAME=$(tailscale status --self --json 2>/dev/null | grep -m1 '"DNSName"' | sed -E 's/.*"DNSName": *"([^."]+).*/\1/')
fi
[ -z "$SELF_NAME" ] && SELF_NAME=$(hostname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')

remote_bash_script() {
  local repos_csv="$1" dry="$2"
  cat <<EOF
for root in "\$HOME/repos" "/c/repos" "/d/repos"; do
  [ -d "\$root" ] && REPO_ROOT="\$root" && break
done
[ -z "\${REPO_ROOT:-}" ] && exit 0
REPO_DIRS=()
if [ -z "$repos_csv" ]; then
  while IFS= read -r gitdir; do
    REPO_DIRS+=("\$(dirname "\$gitdir")")
  done < <(find "\$REPO_ROOT" -maxdepth 3 -name .git -type d 2>/dev/null)
else
  IFS=',' read -ra REPO_NAMES <<< "$repos_csv"
  for n in "\${REPO_NAMES[@]}"; do REPO_DIRS+=("\$REPO_ROOT/\$n"); done
fi
for repo in "\${REPO_DIRS[@]}"; do
  name=\$(basename "\$repo")
  [ -d "\$repo/.git" ] || continue
  cd "\$repo" || continue
  fetch_err=\$(git fetch --quiet 2>&1)
  fetch_rc=\$?
  branch=\$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  dirty=\$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if [ "\$fetch_rc" -ne 0 ]; then
    echo "\$name|\$branch|error|fetch-failed:\$(echo "\$fetch_err" | head -1 | tr '|' '/')"
    continue
  fi
  behind=\$(git rev-list --count HEAD..@{u} 2>/dev/null)
  if [ -z "\$behind" ]; then
    echo "\$name|\$branch|error|no-upstream-or-rev-list-failed"
    continue
  fi
  if [ "\$behind" = "0" ]; then
    echo "\$name|\$branch|skip|up-to-date"
    continue
  fi
  if [ "\$dirty" != "0" ]; then
    echo "\$name|\$branch|skip|dirty(\$dirty)-manual-review-needed"
    continue
  fi
  if [ "$dry" = "1" ]; then
    echo "\$name|\$branch|would-pull|\$behind-commits-behind"
    continue
  fi
  if git merge-base --is-ancestor HEAD "@{u}" 2>/dev/null && git pull --ff-only --quiet 2>/dev/null; then
    echo "\$name|\$branch|pulled|\$behind-commits"
  else
    echo "\$name|\$branch|failed|not-a-fast-forward-or-pull-error"
  fi
done
EOF
}

remote_ps_script() {
  local repos_csv="$1" dry="$2"
  cat <<EOF
\$ProgressPreference = 'SilentlyContinue'
\$roots = @("C:\repos","D:\repos")
\$repoRoot = \$roots | Where-Object { Test-Path \$_ } | Select-Object -First 1
if (-not \$repoRoot) { exit 0 }
if ("$repos_csv" -eq "") {
  \$repoDirs = Get-ChildItem -Path \$repoRoot -Directory -Recurse -Depth 2 -Filter ".git" -Force -ErrorAction SilentlyContinue | ForEach-Object { \$_.Parent.FullName }
} else {
  \$repoNames = "$repos_csv" -split ","
  \$repoDirs = \$repoNames | ForEach-Object { Join-Path \$repoRoot \$_ }
}
foreach (\$repo in \$repoDirs) {
  \$name = Split-Path \$repo -Leaf
  if (-not (Test-Path (Join-Path \$repo ".git"))) { continue }
  Push-Location \$repo
  \$fetchErr = (git fetch --quiet 2>&1)
  \$fetchOk = (\$LASTEXITCODE -eq 0)
  \$branch = git rev-parse --abbrev-ref HEAD 2>\$null
  \$dirty = (git status --porcelain 2>\$null | Measure-Object -Line).Lines
  if (-not \$fetchOk) {
    \$firstLine = (\$fetchErr | Select-Object -First 1) -replace '\|','/'
    Write-Output "\$name|\$branch|error|fetch-failed:\$firstLine"
    Pop-Location
    continue
  }
  \$behind = (git rev-list --count 'HEAD..@{u}' 2>\$null)
  if ([string]::IsNullOrEmpty(\$behind)) {
    Write-Output "\$name|\$branch|error|no-upstream-or-rev-list-failed"
  } elseif (\$behind -eq "0") {
    Write-Output "\$name|\$branch|skip|up-to-date"
  } elseif (\$dirty -ne 0) {
    Write-Output "\$name|\$branch|skip|dirty(\$dirty)-manual-review-needed"
  } elseif ("$dry" -eq "1") {
    Write-Output "\$name|\$branch|would-pull|\$behind-commits-behind"
  } else {
    git merge-base --is-ancestor HEAD '@{u}' 2>\$null
    if (\$LASTEXITCODE -eq 0) {
      git pull --ff-only --quiet 2>\$null
      if (\$LASTEXITCODE -eq 0) {
        Write-Output "\$name|\$branch|pulled|\$behind-commits"
      } else {
        Write-Output "\$name|\$branch|failed|pull-error"
      }
    } else {
      Write-Output "\$name|\$branch|failed|not-a-fast-forward"
    }
  }
  Pop-Location
}
EOF
}

# Portable per-call deadline + retry, matching fleet-git-check: ConnectTimeout
# only bounds the TCP handshake, so a host that accepts the connection but
# then hangs (auth stall, stuck login script, half-dead network) can block
# forever with no other guard, and a single flaky SSH handshake (busy
# Tailscale relay, sleeping box waking up) shouldn't read as UNREACHABLE when
# a moment later the same host answers fine.
run_with_timeout() {
  local secs="$1"; shift
  "$@" &
  local pid=$!
  local waited=0
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    waited=$((waited + 1))
    if [ "$waited" -ge "$secs" ]; then
      kill -9 "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
      return 124
    fi
  done
  wait "$pid"
}

RETRY_ATTEMPTS=3
RETRY_DELAY=3
run_with_retry() {
  local timeout_secs="$1"; shift
  local attempt out
  for ((attempt=1; attempt<=RETRY_ATTEMPTS; attempt++)); do
    if out=$(run_with_timeout "$timeout_secs" "$@" 2>/dev/null); then
      printf '%s' "$out"
      return 0
    fi
    [ "$attempt" -lt "$RETRY_ATTEMPTS" ] && sleep "$RETRY_DELAY"
  done
  return 1
}

printf "%-24s %-16s %-10s %-10s %s\n" "HOST" "REPO" "BRANCH" "RESULT" "DETAIL"
printf "%-24s %-16s %-10s %-10s %s\n" "----" "----" "------" "------" "------"

for host in "${HOSTS[@]}"; do
  if ! os=$(host_os "$host"); then
    echo "!! unknown host: $host (skipping)" >&2
    continue
  fi

  if [ "$host" = "$SELF_NAME" ]; then
    script=$(remote_bash_script "$REPOS" "$DRY_RUN")
    output=$(bash -c "$script" 2>/dev/null)
  elif [ "$os" = "win" ]; then
    script=$(remote_ps_script "$REPOS" "$DRY_RUN")
    encoded=$(printf '%s' "$script" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n')
    if ! output=$(run_with_retry 20 ssh -o ConnectTimeout=5 -o BatchMode=yes "$host" "powershell -NoProfile -EncodedCommand $encoded" 2>/dev/null); then
      printf "%-24s %s\n" "$host" "UNREACHABLE or SSH error (after $RETRY_ATTEMPTS attempts)"
      continue
    fi
  else
    script=$(remote_bash_script "$REPOS" "$DRY_RUN")
    # Base64-encode and pipe through the remote command rather than a heredoc
    # into "bash -s": run_with_timeout backgrounds ssh (`"$@" &`), and in a
    # non-interactive shell a backgrounded command has its stdin implicitly
    # redirected from /dev/null, silently discarding any heredoc/here-string
    # meant for it. Encoding the script into the command line itself sidesteps
    # that entirely (mirrors the win branch's -EncodedCommand approach).
    encoded=$(printf '%s' "$script" | base64 | tr -d '\n')
    if ! output=$(run_with_retry 20 ssh -o ConnectTimeout=5 -o BatchMode=yes "$host" "echo $encoded | base64 -d | bash" 2>/dev/null); then
      printf "%-24s %s\n" "$host" "UNREACHABLE or SSH error (after $RETRY_ATTEMPTS attempts)"
      continue
    fi
  fi

  if [ -z "$output" ]; then
    printf "%-24s %s\n" "$host" "(no target repos found)"
    continue
  fi

  while IFS='|' read -r repo branch result detail; do
    repo="${repo%$'\r'}"; branch="${branch%$'\r'}"; result="${result%$'\r'}"; detail="${detail%$'\r'}"
    [ -z "$repo" ] && continue
    printf "%-24s %-16s %-10s %-10s %s\n" "$host" "$repo" "$branch" "$result" "$detail"
  done <<< "$output"
done
