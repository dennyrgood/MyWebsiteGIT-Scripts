#!/usr/bin/env bash
# wall — launch the fleet status wall in a screen-filling Fleet-profile Terminal window
# 2026-08-26 ~18:15 UTC — initial version: load tmuxp wall, then bias row heights
# 2026-08-26 ~18:45 UTC — removed row-bias resize; added even re-tile so all panes render
# 2026-08-26 ~19:05 UTC — open in Fleet profile + maximize via AppleScript
# 2026-08-26 ~19:20 UTC — more robust profile selection: set current settings on the new window explicitly
# 2026-08-26 ~19:45 UTC — fill screen via explicit window bounds (normal window, accepts overlays)
# 2026-08-26 ~20:05 UTC — support a saved LAYOUT string (paste captured 5-col layout below); falls back to tiled
# 2026-08-26 ~21:35 UTC — add per-pane hostname border labels (single-line do script; avoids multi-line parse error)
# 2026-08-26 ~22:10 UTC — allow-rename off so Windows conhost title can't overwrite RWS/S3G pane labels
# Paste your captured 5-column layout string between the quotes to lock it.
# Leave empty to use tmux's default tiled grid.
# LAYOUT=""
# LAYOUT="230c,313x141,0,0[313x41,0,0{77x41,0,0,50,77x41,78,0,51,77x41,156,0,52,79x41,234,0,53},313x40,0,42{77x40,0,42,54,77x40,78,42,55,77x40,156,42,56,79x40,234,42,57},313x40,0,83{77x40,0,83,58,77x40,78,83,59,77x40,156,83,60,79x40,234,83,61},313x17,0,124,62]"
# LAYOUT="0e21,313x141,0,0[313x37,0,0{76x37,0,0,50,78x37,77,0,51,77x37,156,0,52,79x37,234,0,53},313x41,0,38{76x41,0,38,54,78x41,77,38,55,77x41,156,38,56,79x41,234,38,57},313x38,0,80{76x38,0,80,58,78x38,77,80,59,77x38,156,80,60,79x38,234,80,61},313x22,0,119,62]"
# LAYOUT="0e21,313x141,0,0[313x37,0,0{76x37,0,0,50,78x37,77,0,51,77x37,156,0,52,79x37,234,0,53},313x41,0,38{76x41,0,38,54,78x41,77,38,55,77x41,156,38,56,79x41,234,38,57},313x38,0,80{76x38,0,80,58,78x38,77,80,59,77x38,156,80,60,79x38,234,80,61},313x22,0,119,62]"
LAYOUT="ced6,313x141,0,0[313x43,0,0{76x43,0,0,50,78x43,77,0,51,77x43,156,0,52,79x43,234,0,53},313x40,0,44{76x40,0,44,54,78x40,77,44,55,77x40,156,44,56,79x40,234,44,57},313x37,0,85{76x37,0,85,58,78x37,77,85,59,77x37,156,85,60,79x37,234,85,61},313x18,0,123,62]"
osascript <<EOF
tell application "Terminal"
    set fleetWin to do script "tmuxp load -d -y ~/repos/fleet-configs/fleet.yaml; tmux set -t fleet pane-border-status top; tmux set -t fleet pane-border-format ' #{pane_title} '; tmux set -t fleet allow-rename off; if [ -n '$LAYOUT' ]; then tmux select-layout -t fleet:wall '$LAYOUT'; else tmux select-layout -t fleet:wall tiled; fi; tmux select-pane -t fleet:wall.0 -T AMSTDT; tmux select-pane -t fleet:wall.1 -T CWH; tmux select-pane -t fleet:wall.2 -T IB; tmux select-pane -t fleet:wall.3 -T TB; tmux select-pane -t fleet:wall.4 -T RWS; tmux select-pane -t fleet:wall.5 -T S3G; tmux select-pane -t fleet:wall.6 -T SGC; tmux select-pane -t fleet:wall.7 -T WBU; tmux select-pane -t fleet:wall.8 -T CWHU; tmux select-pane -t fleet:wall.9 -T NAS; tmux select-pane -t fleet:wall.10 -T MMM; tmux select-pane -t fleet:wall.11 -T MB2; tmux select-pane -t fleet:wall.12 -T MB; tmux attach -t fleet"
    set current settings of fleetWin to settings set "Fleet"
    activate
    delay 1.5
end tell
tell application "Finder" to set screenBounds to bounds of window of desktop
set {sx, sy, sw, sh} to screenBounds
tell application "Terminal" to set bounds of front window to {0, 25, sw, sh}
EOF
