<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dennis.fleet-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/dennishmathes/repos/scripts/Status/fleet_digest.py</string>
        <string>--send</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dennishmathes/repos/scripts/Status</string>

    <!-- 8am -- an hour after every box's own 7am nightly-summary, giving the rolling
         30h window in fleet_digest.py plenty of margin even across the fleet's
         timezone spread (UTC-4 to UTC+2). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <!-- Matches mb-nightly-summary.plist's fix (2026-08-05) -- see that plist's
         comment for the underlying launchd-throttling issue this avoids. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/dennishmathes/Library/Logs/fleet_digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dennishmathes/Library/Logs/fleet_digest.log</string>
</dict>
</plist>
