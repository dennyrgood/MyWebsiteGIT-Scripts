<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dennis.comfy-fleet-http</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>http.server</string>
        <string>5050</string>
        <string>--bind</string>
        <string>0.0.0.0</string>
    </array>

    <!-- 2026-08-31: switched off the live OneDrive-synced dir to a local mirror
         (comfyui/fleet-output-local/, refreshed daily by scheduled_scan.sh) --
         a long-running process holding OneDrive's fleet-output/ as its cwd was
         getting its directory handle invalidated by OneDrive's own sync churn,
         wedging this server's directory listing for hours at a time. -->
    <key>WorkingDirectory</key>
    <string>/Users/dennishmathes/repos/scripts/comfyui/fleet-output-local</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/dennishmathes/Library/Logs/comfy_fleet_http.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dennishmathes/Library/Logs/comfy_fleet_http.log</string>
</dict>
</plist>
