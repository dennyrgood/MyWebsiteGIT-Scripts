<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dennis.mmm-plex-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dennishmathes/repos/scripts/MathesMacMini/backup_plex_to_fleetnas.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dennishmathes/repos/scripts/MathesMacMini</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <!-- 2026-08-05: without this, every launchd-triggered run (StartCalendarInterval
         AND launchctl kickstart) died at ~300s with an rsync "io timeout" mid-transfer,
         while the identical script run interactively from Terminal completed in 53s.
         Root cause: launchd assigns background agents (no RunAtLoad+KeepAlive) a
         throttled process/QoS class by default, distinct from an interactive shell's.
         Interactive opts this job out, scheduling it like a foreground app instead. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/dennishmathes/Library/Logs/mmm_plex_backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dennishmathes/Library/Logs/mmm_plex_backup.log</string>
</dict>
</plist>
