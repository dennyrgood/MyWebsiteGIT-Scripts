<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dennis.mmm-nightly-summary</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dennishmathes/repos/scripts/MathesMacMini/nightly_summary.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dennishmathes/repos/scripts/MathesMacMini</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <!-- 2026-08-05: matches mmm-plex-backup.plist's fix — background launchd agents
         (no RunAtLoad+KeepAlive) get throttled by macOS by default, which caused that
         agent's rsync to die at ~300s under launchd but not interactively. Applied
         here too since this job also does network I/O (msmtp send). -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/dennishmathes/Library/Logs/mmm_nightly_summary.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dennishmathes/Library/Logs/mmm_nightly_summary.log</string>
</dict>
</plist>
